        _G.TPStatus = "no_brainrot_pos"
        return
    end

    local centerPos = oneWayPart.Position
    local target    = centerPos

    if isAtTarget(target) or ThirdFloorDone then
        _G.TPStatus = "already_at_target_3rd"
        return
    end

    if brainPos.Y >= 30 then
        ThirdFloorDone = true

        vZero(hrp)
        velDirectTo(hrp, target, Config.TpSettings.WalkToBrainrotSpd or 50)

        if IsAlive() then
            unequipAllToolsLocal()
            safeSnap(hrp, target)
            vZero(hrp)
        end

        _G.TPStatus = "at_brainrot_3rd_floor"
        return
    end

    vZero(hrp)
    velMoveSimple(hrp, brainPos)
    if IsAlive() then
        safeSnap(hrp, brainPos)
    end
    _G.TPStatus = "at_brainrot"
end

local isTeleporting = false
_G.TPStatus = "idle"

local function doVelocityTP()
    if isTeleporting then return end
    isTeleporting = true
    ThirdFloorDone = false
    _G.TPStatus = "start"
    if not NetModule2 then pcall(loadNet) end
    local char = LP.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum then _G.TPStatus = "no_char"; isTeleporting = false; return end
    local selData = getPrioritySelected()
    if not selData then
        _G.TPStatus = "no_priority_selection"
        isTeleporting = false
        return
    end
    local savedSel = selData
    local petPos = selData.worldPosition or nil
    if not petPos and selData.plot and selData.slot then
        local plots = Workspace:FindFirstChild("Plots")
        if plots then
            local plot = plots:FindFirstChild(selData.plot)
            local podiums = plot and plot:FindFirstChild("AnimalPodiums")
            local podium = podiums and podiums:FindFirstChild(tostring(selData.slot))
            if podium then
                local ok, cf = pcall(function() return podium:GetPivot() end)
                if ok then petPos = cf.Position end
            end
        end
    end
    if not petPos then
        _G.TPStatus = "no_pet_position"
        isTeleporting = false
        return
    end
    local petName = selData.name or selData.petName or "?"
    _G.TPStatus = "target=" .. tostring(petName)
    local adjY = petPos.Y
    if TALL_PETS[petName] then adjY = petPos.Y - TALL_OFFSET end
    local coordTable = adjY > UPPER_Y_THRESHOLD and UPPER or LOWER
    local closestData = findClosest(petPos, coordTable)
    if not closestData then _G.TPStatus = "no_sky_platform"; isTeleporting = false; return end
    local destPos = closestData.coord
    local maxHP = hum.MaxHealth
    hum.Health = maxHP
    local healConn = RunService.Heartbeat:Connect(function()
        if hum and hum.Parent then hum.Health = maxHP end
    end)
    local toolChoice = Config.ToolChoice or "Grapple"
    if toolChoice == "Grapple" then
        local hookName = equipGrapple()
        _G.TPStatus = "hook=" .. tostring(hookName)
        pcall(function()
            if NetModule2 and LP.Character and LP.Character:FindFirstChild("Grapple Hook") then
                NetModule2:RemoteEvent("UseItem"):FireServer(2)
            end
        end)
        task.wait(0.15)
        pcall(function() hum:UnequipTools() end)
        task.wait(0.15)
        _G.VanishCarpetSpeed = Config.TpSettings.TpGrappleSpeed or 190
    else
        _G.VanishCarpetSpeed = Config.TpSettings.TpV2Speed or 160
    end
    local cn = carpetEngage()
    _G.TPStatus = "carpet=" .. tostring(cn)
    vZeroLocal(hrp)
    local facingDir = closestData.facing == "NORTH" and Vector3.new(0,0,-1) or Vector3.new(0,0,1)
    local speedOverride = (toolChoice == "Grapple") and (Config.TpSettings.TpGrappleSpeed or 190) or (Config.TpSettings.TpV2Speed or 160)
    local route = computeRoute(hrp.Position, destPos, facingDir)
    velMoveThrough(hrp, route, speedOverride)
    hrp.CFrame = CFrame.new(destPos, destPos + facingDir)
    vZeroLocal(hrp)
    local syncFrames = 5
    local syncConn
    syncConn = RunService.Heartbeat:Connect(function()
        if not hrp or not hrp.Parent then syncConn:Disconnect(); return end
        syncFrames -= 1
        hrp.CFrame = CFrame.new(destPos, destPos + facingDir)
        vZeroLocal(hrp)
        if syncFrames <= 0 then syncConn:Disconnect() end
    end)
    for _ = 1, 20 do
        task.wait(0.05)
        if hum.FloorMaterial ~= Enum.Material.Air then break end
    end
    healConn:Disconnect()
    isTeleporting = false
    do
        local stable = 0
        for _ = 1, 50 do
            local _hrp = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
            if not _hrp or not _hrp.Parent then break end
            local flat = (Vector2.new(_hrp.Position.X, _hrp.Position.Z) - Vector2.new(destPos.X, destPos.Z)).Magnitude
            if flat <= 3.5 and math.abs(_hrp.Position.Y - destPos.Y) <= 4 then
                stable += 1
                if stable >= 4 then break end
            else
                stable = 0
                pcall(function() _hrp.CFrame = CFrame.new(destPos, destPos + facingDir) end)
                vZeroLocal(_hrp)
            end
            RunService.Heartbeat:Wait()
        end
    end
    _G.TPStatus = "at_sky_before_clone"
    local _ahrp = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
    if _ahrp and _ahrp.Parent then
        vZeroLocal(_ahrp)
        pcall(function() _ahrp.CFrame = CFrame.new(destPos, destPos + facingDir) end)
        pcall(function() _ahrp.Anchored = true end)
    end
    task.wait(Config.TpSettings.CloneDelay or 0.25)
    if _ahrp and _ahrp.Parent then pcall(function() _ahrp.Anchored = false end) end
    local cloneOk = doCloneUnified()
    if cloneOk then
        _G.TPStatus = "clone_ok_waiting"
        AfterClone_VelocityUnified(savedSel)
        task.wait(0)
        pcall(function()
            VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.C, false, game)
            task.wait(0.05)
            VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.C, false, game)
        end)
        local _fhrp = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
        if _fhrp and _fhrp.Parent then
            vZeroLocal(_fhrp)
        end
    else
        _G.TPStatus = "clone_FAILED"
        local _fhrp = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
        if _fhrp and _fhrp.Parent then
            vZeroLocal(_fhrp)
        end
    end
end

