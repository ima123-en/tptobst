local SPEED = 200
local ARRIVE = 3

local function vZeroLocal(hrp)
    if hrp then
        hrp.AssemblyLinearVelocity = Vector3.zero
        hrp.AssemblyAngularVelocity = Vector3.zero
    end
end

local function velMoveThrough(hrp, waypoints, speedOverride)
    if not hrp or not hrp.Parent or #waypoints == 0 then return end
    local wpIdx = 1
    local done = false
    local conn
    local function finish()
        if done then return end
        done = true
        if hrp and hrp.Parent then
            vZeroLocal(hrp)
            local last = waypoints[#waypoints]
            hrp.CFrame = CFrame.new(last, last + hrp.CFrame.LookVector)
        end
        if conn then conn:Disconnect() end
    end
    local lastDist, stall = math.huge, 0
    conn = RunService.Heartbeat:Connect(function()
        if not hrp or not hrp.Parent or done then
            if conn then conn:Disconnect() end
            return
        end
        equipCarpetOnlyLocal()
        local target = waypoints[wpIdx]
        local diff = target - hrp.Position
        local mag = diff.Magnitude
        if mag < ARRIVE then
            wpIdx = wpIdx + 1
            if wpIdx > #waypoints then finish() return end
            lastDist, stall = math.huge, 0
            target = waypoints[wpIdx]
            diff = target - hrp.Position
            mag = diff.Magnitude
        end
        if mag > lastDist - 0.05 then stall = stall + 1 else stall = 0 end
        lastDist = mag
        if stall >= 18 then finish() return end
        if mag >= 0.1 then
            local dir = diff.Unit
            local spd = speedOverride or (_G.VanishCarpetSpeed or CARPET_SPEED)
            hrp.Velocity = Vector3.new(dir.X * spd, dir.Y * spd, dir.Z * spd)
        end
    end)
    local totalDist = 0
    local prev = hrp.Position
    for _, wp in ipairs(waypoints) do
        totalDist = totalDist + (prev - wp).Magnitude
        prev = wp
    end
    local timeout = totalDist / (speedOverride or SPEED) + 2
    local elapsed = 0
    while not done and elapsed < timeout do
        task.wait(0.05)
        elapsed += 0.05
    end
    finish()
    vZeroLocal(hrp)
end

local _STRUCT = { ["structure base home"] = true, ["Wall"] = true, ["Floor"] = true, ["Roof"] = true }
local _SKIP_NAME = { ["DeliveryHitbox"]=true, ["StealHitbox"]=true, ["LaserHitbox"]=true,
    ["AnimalTarget"]=true, ["Multiplier"]=true, ["Laser"]=true, ["Hitbox"]=true,
    ["Spawn"]=true, ["MainRoot"]=true, ["SecondFloor"]=true, ["ThirdFloor"]=true, ["Slope"]=true }

local function _blocks(inst)
    if not inst then return false end
    if _SKIP_NAME[inst.Name] then return false end
    if inst.CanCollide then return true end
    if _STRUCT[inst.Name] then return true end
    local s = inst.Size
    if s and math.max(s.X * s.Y, s.X * s.Z, s.Y * s.Z) > 150 then return true end
    return false
end

local function _block(origin, target)
    local rp = RaycastParams.new()
    rp.FilterType = Enum.RaycastFilterType.Exclude
    rp.IgnoreWater = true
    local skip = {}
    for _, pl in ipairs(Players:GetPlayers()) do
        if pl.Character then skip[#skip + 1] = pl.Character end
    end
    local o = origin
    for _ = 1, 16 do
        rp.FilterDescendantsInstances = skip
        local d = target - o
        if d.Magnitude < 0.05 then return nil end
        local res = Workspace:Raycast(o, d, rp)
        if not res then return nil end
        if _blocks(res.Instance) then return res end
        skip[#skip + 1] = res.Instance
        o = res.Position + d.Unit * 0.3
    end
    return nil
end

local function _clear(a, b) return _block(a, b) == nil end

local _CLEARANCE = 6
local function _clearWide(a, b)
    if not _clear(a, b) then return false end
    local d = Vector3.new(b.X - a.X, 0, b.Z - a.Z)
    if d.Magnitude < 0.1 then return true end
    local p = Vector3.new(-d.Z, 0, d.X).Unit * _CLEARANCE
    return _clear(a + p, b + p) and _clear(a - p, b - p)
end

local function computeRoute(fromPos, toPos, facingDir)
    if _clear(fromPos, toPos) then
        return { toPos }
    end

    local entry = facingDir and (toPos - facingDir * 14) or toPos
    local groundFrom = Vector3.new(fromPos.X, fromPos.Y, fromPos.Z)
    local groundTo   = Vector3.new(entry.X, fromPos.Y, entry.Z)

    local path = PathfindingService:CreatePath({
        AgentRadius      = 6,
        AgentHeight      = 6,
        AgentCanJump     = true,
        AgentJumpHeight  = 12,
        AgentMaxSlope    = 45,
        Costs = { Water = 100 },
    })

    local ok = pcall(function()
        path:ComputeAsync(groundFrom, groundTo)
    end)
    if not ok or path.Status ~= Enum.PathStatus.Success then
        return { entry + Vector3.new(0, 3, 0), toPos }
    end

    local waypoints = path:GetWaypoints()
    if #waypoints == 0 then
        return { entry + Vector3.new(0, 3, 0), toPos }
    end

    local FLOAT = 3
    local raw = {}

    table.insert(raw, fromPos + Vector3.new(0, FLOAT, 0))

    local lastAdded = waypoints[1].Position
    table.insert(raw, lastAdded + Vector3.new(0, FLOAT, 0))

    for i = 2, #waypoints do
        local pos = waypoints[i].Position
        if (pos - lastAdded).Magnitude >= 6 then
            table.insert(raw, pos + Vector3.new(0, FLOAT, 0))
            lastAdded = pos
        end
    end

    table.insert(raw, entry + Vector3.new(0, FLOAT, 0))
    table.insert(raw, toPos)

    if #raw <= 2 then
        return raw
    end

    local simplified = { raw[1] }
    local currentIndex = 1

    while currentIndex < #raw do
        local bestIndex = currentIndex + 1
        for i = #raw, currentIndex + 1, -1 do
            local a = simplified[#simplified]
            local b = raw[i]
            if _clearWide(a, b) then
                bestIndex = i
                break
            end
        end
        table.insert(simplified, raw[bestIndex])
        currentIndex = bestIndex
    end

    for i = 1, #simplified do
        local p = simplified[i]
        simplified[i] = Vector3.new(p.X, p.Y, p.Z)
    end

    return simplified
end

