local Y_OFFSET = 3

local function vZero(hrp)
    if not hrp then return end
    hrp.AssemblyLinearVelocity  = Vector3.zero
    hrp.AssemblyAngularVelocity = Vector3.zero
    hrp.Velocity                = Vector3.zero
    hrp.RotVelocity             = Vector3.zero
end

local function safeSnap(hrp, pos)
    if not hrp then return end
    vZero(hrp)
    local final = pos - Vector3.new(0, Y_OFFSET, 0)
    hrp.CFrame = CFrame.new(final)
end

local function velDirectTo(hrp, destPos, speed)
    if not hrp or not hrp.Parent then return end
    speed = speed or (Config.TpSettings.WalkToBrainrotSpd or 50)

    local target = destPos - Vector3.new(0, Y_OFFSET, 0)
    local done = false
    local conn

    conn = RunService.Heartbeat:Connect(function()
        if not hrp or not hrp.Parent or done then
            if conn then conn:Disconnect() end
            return
        end

        equipCarpetOnlyLocal()

        local diff = target - hrp.Position
        local mag  = diff.Magnitude

        if mag < 1.2 then
            done = true
            vZero(hrp)
            if conn then conn:Disconnect() end
            return
        end

        hrp.AssemblyLinearVelocity = diff.Unit * speed
    end)

    local timeout = (hrp.Position - target).Magnitude / speed + 3
    local t0 = tick()
    while not done and tick() - t0 < timeout do
        task.wait(0.05)
    end

    done = true
    vZero(hrp)
    if conn then conn:Disconnect() end
end

local SPEED_SIMPLE  = Config.TpSettings.WalkToBrainrotSpd or 50
local ARRIVE_SIMPLE = 3

local function velMoveSimple(hrp, dest)
    if not hrp or not hrp.Parent then return end
    local done = false
    local conn
    conn = RunService.Heartbeat:Connect(function()
        if not hrp or not hrp.Parent or done then
            if conn then conn:Disconnect() end
            return
        end
        equipCarpetOnlyLocal()
        local diff = dest - hrp.Position
        if diff.Magnitude < ARRIVE_SIMPLE then
            done = true
            vZero(hrp)
            return
        end
        hrp.AssemblyLinearVelocity = diff.Unit * SPEED_SIMPLE
    end)
    local timeout = (hrp.Position - dest).Magnitude / SPEED_SIMPLE + 3
    local t0 = tick()
    while not done and tick() - t0 < timeout do
        task.wait(0.05)
    end
    done = true
    vZero(hrp)
    if conn then conn:Disconnect() end
end

